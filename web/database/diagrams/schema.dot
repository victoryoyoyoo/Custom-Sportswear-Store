digraph S {
  graph [rankdir=LR, fontname="Microsoft JhengHei", bgcolor="white", pad="0.4", nodesep="0.5", ranksep="1.1", splines=true];
  node [shape=plain, fontname="Microsoft JhengHei"];
  edge [color="#7B8494", penwidth=1.3, arrowhead=crowodot, arrowtail=teetee, dir=both];
  T1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2F5D8C"><TR><TD BGCOLOR="#2F5D8C" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="14"><B>顧客</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13"><B>顧客編號</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">姓名</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">電子郵件</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">手機</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">縣市</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">加入日期</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR></TABLE>>];
  T2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2F5D8C"><TR><TD BGCOLOR="#2F5D8C" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="14"><B>訂單</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13"><B>訂單編號</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">顧客編號</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">訂購日期</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">狀態</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">付款方式</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">收件人</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">收件電話</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">收件縣市</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">收件地址</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">備註</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR></TABLE>>];
  T3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2F5D8C"><TR><TD BGCOLOR="#2F5D8C" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="14"><B>訂單明細</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13"><B>訂單編號</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13"><B>項次</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">商品編號</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">顏色代碼</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">尺寸</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">數量</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">成交單價</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR></TABLE>>];
  T4 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2F5D8C"><TR><TD BGCOLOR="#2F5D8C" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="14"><B>商品</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13"><B>商品編號</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">商品名稱</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">分類編號</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">定價</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">圖片代碼</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">說明</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">上架</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR></TABLE>>];
  T5 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2F5D8C"><TR><TD BGCOLOR="#2F5D8C" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="14"><B>商品尺寸</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13"><B>商品編號</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13"><B>尺寸</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">排序</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR></TABLE>>];
  T6 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2F5D8C"><TR><TD BGCOLOR="#2F5D8C" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="14"><B>分類</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13"><B>分類編號</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">分類名稱</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">UQ</FONT></TD></TR></TABLE>>];
  T7 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2F5D8C"><TR><TD BGCOLOR="#2F5D8C" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="14"><B>顏色</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13"><B>顏色代碼</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#2F5D8C">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">顏色名稱</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">色碼</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">排序</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#FFFFFF">.</FONT></TD></TR></TABLE>>];
  T1 -> T2;
  T2 -> T3;
  T4 -> T3;
  T7 -> T3;
  T6 -> T4;
  T4 -> T5;
  {rank=same; T1; T6;}
  {rank=same; T2; T4; T7;}
  {rank=same; T3; T5;}
}